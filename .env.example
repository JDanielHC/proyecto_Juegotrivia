# Copien este archivo como .env.local y llenen los datos reales.
# .env.local no se sube a GitHub.

# MariaDB en el servidor Rocky Linux
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trivia_app
DB_PASSWORD=
DB_NAME=retotrivia_uth
# Cuántas conexiones abiertas puede tener la app
DB_POOL=10

# Cuántas horas dura una sesión (168 = 7 días)
SESION_HORAS=168

# Pónganlo en true cuando el sitio ya tenga HTTPS
COOKIE_SEGURA=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=llama3.2:1b
